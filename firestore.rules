rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() { return request.auth != null; }
    function uid()      { return request.auth.uid; }
    function isAdmin()  { return request.auth.token.email == 'alexfotso75@gmail.com'; }

    // ── Utilisateurs ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isAuthed();
      allow create: if isAuthed() && uid() == userId;
      allow update: if isAuthed() && (uid() == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Paramètres (code d'invitation) ────────────────────────────────────
    match /settings/{doc} {
      allow read:   if isAuthed();
      allow write:  if isAdmin();
    }

    // ── Conversations (DM + groupes) ──────────────────────────────────────
    match /conversations/{convId} {
      allow read:   if isAuthed() && uid() in resource.data.participants;
      allow create: if isAuthed() && uid() in request.resource.data.participants;
      allow update: if isAuthed() && uid() in resource.data.participants;
      allow delete: if false;

      match /messages/{msgId} {
        function conv() {
          return get(/databases/$(database)/documents/conversations/$(convId)).data;
        }
        allow read:   if isAuthed() && uid() in conv().participants;
        allow create: if isAuthed() && uid() in conv().participants
                                    && request.resource.data.sender == uid();
        allow update: if isAuthed() && uid() in conv().participants;
        allow delete: if false;
      }
    }

    // ── Canaux de diffusion ───────────────────────────────────────────────
    match /channels/{chanId} {
      allow read:   if isAuthed();
      allow create: if isAdmin();
      allow update: if isAuthed() && (isAdmin() || resource.data.owner == uid());
      allow delete: if isAdmin();

      match /posts/{postId} {
        allow read:   if isAuthed();
        allow create: if isAuthed() && (
          isAdmin() ||
          get(/databases/$(database)/documents/channels/$(chanId)).data.owner == uid()
        );
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ── Fichiers partagés ─────────────────────────────────────────────────
    match /sharedFiles/{fileId} {
      allow read:   if isAuthed() && uid() in resource.data.participants;
      allow create: if isAuthed() && uid() in request.resource.data.participants;
      allow update: if false;
      allow delete: if isAuthed() && resource.data.sender == uid();
    }
  }
}
